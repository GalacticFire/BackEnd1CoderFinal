<html lang="es" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>

    <!-- Google Fonts: Inter (Tipografía de alta legibilidad) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons (Requerido para los diseños del carrito y productos) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>

    <nav
      class="navbar navbar-expand-lg navbar-dark navbar-glass sticky-top py-3"
    >
      <div class="container d-flex justify-content-between align-items-center">

        <a
          href="/"
          class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2 tracking-tight"
        >
          <i class="bi bi-box-fill text-white"></i>
          EntregaFinalCoder
        </a>

        <button
          class="navbar-toggler border-0 shadow-none"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div
          class="collapse navbar-collapse justify-content-end"
          id="navbarNav"
        >
          <ul class="navbar-nav align-items-center gap-2 mt-3 mt-lg-0">
            <li class="nav-item">
              <a href="/products" class="nav-link fw-medium px-3">Productos</a>
            </li>
            <li class="nav-item">
              <!-- Enlace del carrito corregido -->
              <a
                href="#"
                id="cart-link"
                class="nav-link fw-medium px-3 d-flex align-items-center gap-2"
              >
                <i class="bi bi-cart fs-5"></i>
                <span>Carrito</span>
              </a>
            </li>
          </ul>
        </div>

      </div>
    </nav>

    <main class="container py-5">
      {{{body}}}
    </main>

    <footer
      class="border-top py-4 mt-auto"
      style="border-color: rgba(255,255,255,0.1) !important;"
    >
      <div class="container text-center text-secondary small">
        &copy; 2026 EntregaFinalCoder. Todos los derechos reservados.
      </div>
    </footer>

    <script src="/socket.io/socket.io.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
    <script src="/js/main.js"></script>

  </body>
</html>