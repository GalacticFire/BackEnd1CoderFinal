<div class="container py-4">
  <h1 class="mb-5 fw-bold">Lista de Productos</h1>

  <div class="row g-4">

    {{#if products.length}}

      {{#each products}}
        <div class="col-12 col-sm-6 col-lg-4">
          <div
            class="card h-100 border-0 shadow-sm rounded-4 position-relative overflow-hidden"
          >

            <!-- Badge de Estado -->
            <div class="position-absolute top-0 end-0 p-3">
              {{#if (gt this.stock 0)}}
                <span
                  class="badge rounded-pill text-bg-success shadow-sm"
                >Disponible</span>
              {{else}}
                <span
                  class="badge rounded-pill text-bg-danger shadow-sm"
                >Agotado</span>
              {{/if}}
            </div>

            <div class="card-body p-4 d-flex flex-column">
              <!-- Categoría y Título -->
              <p
                class="text-uppercase text-muted small fw-bold mb-1"
                style="letter-spacing: 0.5px;"
              >
                {{this.category}}
              </p>
              <h5 class="card-title fw-bold mb-3">
                {{this.title}}
              </h5>

              <!-- Descripción -->
              <p class="card-text text-muted mb-4">
                {{this.description}}
              </p>

              <!-- Precio y Stock (empuja el botón hacia abajo) -->
              <div
                class="mt-auto d-flex justify-content-between align-items-end mb-4"
              >
                <div>
                  <span class="text-muted small d-block">Precio</span>
                  <span class="fs-4 fw-bold text-light">${{this.price}}</span>
                </div>
                <div class="text-end">
                  <span class="text-muted small d-block">Stock</span>
                  <span class="fw-semibold text-light">{{this.stock}} u.</span>
                </div>
              </div>

              <!-- Botón de Acción -->
              <a
                href="/products/{{this._id}}"
                class="btn btn-dark w-100 rounded-pill fw-semibold py-2"
                data-id="{{this._id}}"
              >
                Ver detalles
              </a>
            </div>

          </div>
        </div>
      {{/each}}

    {{else}}

      <!-- ESTADO VACÍO -->
      <div class="col-12 text-center py-5">
        <div class="display-4 text-muted mb-3">
          <i class="bi bi-box-seam"></i>
        </div>
        <h3 class="fw-bold text-muted mb-2">No hay productos disponibles</h3>
        <p class="text-muted">Actualmente no contamos con artículos en esta
          sección.</p>
      </div>

    {{/if}}

  </div>

  <!-- PAGINACIÓN -->
  <div class="d-flex justify-content-center align-items-center gap-3 mt-5">

    {{#if hasPrevPage}}
      <a
        class="btn btn-primary btn btn-light rounded-pill px-3"
        href="/products?page={{prevPage}}"
      >
        ← Anterior
      </a>
    {{/if}}

    <span class="fw-bold text-muted px-2">
      Página
      {{page}}
      de
      {{totalPages}}
    </span>

    {{#if hasNextPage}}
      <a
        class="btn btn-primary btn btn-light rounded-pill px-3"
        href="/products?page={{nextPage}}"
      >
        Siguiente →
      </a>
    {{/if}}

  </div>
</div>