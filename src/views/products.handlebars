<h1 class="mb-4">Lista de Productos</h1>

<div class="row">

  {{#if products.length}}

    {{#each products}}

      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          {{#if (gt this.stock 0)}}
            <span class="badge bg-success">Disponible</span>
          {{else}}
            <span class="badge bg-danger">
              No disponible
            </span>
          {{/if}}
          <div class="card-body">
            <h5 class="card-title">
              {{this.title}}
            </h5>

            <p class="card-text">
              {{this.description}}
            </p>

            <ul class="list-group list-group-flush mb-3">
              <li class="list-group-item">
                <strong>Precio:</strong>
                ${{this.price}}
              </li>

              <li class="list-group-item">
                <strong>Stock:</strong>
                {{this.stock}}
              </li>

              <li class="list-group-item">
                <strong>Categoría:</strong>
                {{this.category}}
              </li>
            </ul>
            <a
              href="products/{{this._id}}"
              class="btn btn-primary w-100"
              data-id="{{this._id}}"
            >Ver detalles</a>
          </div>
          <button
            class="btn btn-success w-100 mt-2 add-to-cart"
            data-id="{{this._id}}"
          >
            Añadir al Carrito
          </button>

        </div>
      </div>
    {{/each}}

  {{else}}

    <div class="col-12">
      <div class="alert alert-warning">
        No hay productos disponibles.
      </div>
    </div>

  {{/if}}

</div>

<div class="d-flex justify-content-center align-items-center gap-3 mt-4">

  {{#if hasPrevPage}}
    <a class="btn btn-outline-dark" href="/products?page={{prevPage}}">
      ← Anterior
    </a>
  {{/if}}

  <span class="fw-bold">
    Página
    {{page}}
    de
    {{totalPages}}
  </span>

  {{#if hasNextPage}}
    <a class="btn btn-outline-dark" href="/products?page={{nextPage}}">
      Siguiente →
    </a>
  {{/if}}

</div>