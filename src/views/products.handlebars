<h1 class="mb-4">Lista de Productos</h1>

<div class="row">

  {{#if products.length}}

    {{#each products}}

      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">

          <div class="card-body">
            <h5 class="card-title">
              {{this.title}}
            </h5>

            <p class="card-text">
              {{this.description}}
            </p>

            <ul class="list-group list-group-flush mb-3">
              <li class="list-group-item">
                <strong>Precio:</strong>
                ${{this.price}}
              </li>

              <li class="list-group-item">
                <strong>Stock:</strong>
                {{this.stock}}
              </li>

              <li class="list-group-item">
                <strong>Categoría:</strong>
                {{this.category}}
              </li>
            </ul>

            {{#if this.status}}
              <span class="badge bg-success">
                Disponible
              </span>
            {{else}}
              <span class="badge bg-danger">
                No disponible
              </span>
            {{/if}}
            {{#if this.status}}
              <button
                class="btn btn-primary w-100 add-to-cart"
                data-id="{{this._id}}"
              >
                Añadir al carrito
              </button>
            {{else}}
              <button class="btn btn-secondary w-100" disabled>
                Sin stock
              </button>
            {{/if}}
            <input
              type="number"
              min="1"
              max="{{this.stock}}"
              value="1"
              class="form-control mb-2 quantity"
            />
          </div>

        </div>
      </div>
    {{/each}}

  {{else}}

    <div class="col-12">
      <div class="alert alert-warning">
        No hay productos disponibles.
      </div>
    </div>

  {{/if}}

</div>

<div class="d-flex justify-content-center align-items-center gap-3 mt-4">

  {{#if hasPrevPage}}
    <a class="btn btn-outline-dark" href="/?page={{prevPage}}">
      ← Anterior
    </a>
  {{/if}}

  <span class="fw-bold">
    Página
    {{page}}
    de
    {{totalPages}}
  </span>

  {{#if hasNextPage}}
    <a class="btn btn-outline-dark" href="/?page={{nextPage}}">
      Siguiente →
    </a>
  {{/if}}

</div>