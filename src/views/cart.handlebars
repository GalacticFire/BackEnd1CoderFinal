<div class="container mt-5">
  <div class="row">
    <div class="col-12 text-center mb-4">
      <h1 class="fw-bold">Resumen de tu Carrito</h1>
      <p class="text-muted">Revisá los productos seleccionados antes de finalizar tu compra.</p>
    </div>
  </div>

  {{#if cart.items.length}}
    <div class="row g-4">
      <!-- LISTA DE PRODUCTOS -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4 py-3">Producto</th>
                    <th class="text-center py-3">Cantidad</th>
                    <th class="text-center py-3">Precio</th>
                    <th class="text-end pe-4 py-3">Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each cart.items}}
                    <tr>
                      <td class="ps-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                          {{#if this.thumbnail}}
                            <img src="{{this.thumbnail}}" alt="{{this.title}}" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;">
                          {{else}}
                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                              <i class="bi bi-image text-muted"></i>
                            </div>
                          {{/if}}
                          <div>
                            <h6 class="mb-0 fw-bold">{{this.title}}</h6>
                            <small class="text-muted">{{this.description}}</small>
                          </div>
                        </div>
                      </td>
                      <td class="text-center fw-semibold">{{this.quantity}} u.</td>
                      <td class="text-center text-muted">${{this.price}}</td>
                      <td class="text-end pe-4 fw-bold text-primary">${{this.subtotal}}</td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        
        <div class="mt-4">
          <a href="/products" class="btn btn-link text-decoration-none text-dark ps-0">
            ← Continuar comprando
          </a>
        </div>
      </div>

      <!-- RESUMEN DE PAGO -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-3">
          <div class="card-body">
            <h4 class="fw-bold mb-4">Total de la Compra</h4>
            
            <div class="d-flex justify-content-between mb-3">
              <span class="text-secondary">Productos ({{cart.items.length}})</span>
              <span>${{cart.total}}</span>
            </div>
            
            <div class="d-flex justify-content-between mb-4">
              <span class="text-secondary">Envío</span>
              <span class="text-success fw-bold">¡Gratis!</span>
            </div>
            
            <hr class="border-secondary">
            
            <div class="d-flex justify-content-between mb-4">
              <span class="fs-5">Monto Total</span>
              <span class="fs-4 fw-bold text-info">${{cart.total}}</span>
            </div>
            
            <button class="btn btn-info w-100 rounded-pill py-3 fw-bold shadow-sm" onclick="alert('Funcionalidad de pago no requerida por la consigna.')">
              Finalizar Pedido
            </button>
          </div>
        </div>
      </div>
    </div>

  {{else}}
    <!-- ESTADO VACÍO -->
    <div class="row justify-content-center py-5">
      <div class="col-md-6 text-center">
        <div class="alert alert-light border shadow-sm p-5 rounded-4">
          <h3 class="fw-bold text-muted">Tu carrito está vacío</h3>
          <p class="text-muted mb-4">¡Date una vuelta por el catálogo y sumá lo que más te guste!</p>
          <a href="/products" class="btn btn-dark rounded-pill px-5 py-2">
            Ver Productos
          </a>
        </div>
      </div>
    </div>
  {{/if}}
</div>
