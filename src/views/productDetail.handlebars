<div class="container mt-4">

  <div class="row">

    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">

          {{#if (gt product.stock 0)}}
            <span class="badge bg-success mb-2">Disponible</span>
          {{else}}
            <span class="badge bg-danger mb-2">No disponible</span>
          {{/if}}

          <h2 class="card-title mb-3">
            {{product.title}}
          </h2>

          <p class="card-text text-muted">
            {{product.description}}
          </p>

          <ul class="list-group list-group-flush mt-3 mb-3">

            <li class="list-group-item">
              <strong>Precio:</strong>
              ${{product.price}}
            </li>

            <li class="list-group-item">
              <strong>Stock:</strong>
              {{product.stock}}
            </li>

            <li class="list-group-item">
              <strong>Categoría:</strong>
              {{product.category}}
            </li>

            {{#if product.code}}
              <li class="list-group-item">
                <strong>Código:</strong>
                {{product.code}}
              </li>
            {{/if}}

          </ul>

          {{#if (gt product.stock 0)}}

            <div class="mb-3">
              <label class="form-label">Cantidad</label>
              <input
                type="number"
                min="1"
                max="{{product.stock}}"
                value="1"
                class="form-control quantity"
                data-id="{{this.quantity}}"
              />
            </div>

            <button
              class="btn btn-success add-to-cart"
              data-id="{{product._id}}"
            >
              Añadir al carrito
            </button>

          {{else}}

            <button class="btn btn-secondary w-100" disabled>
              Sin stock
            </button>

          {{/if}}

        </div>
      </div>
    </div>

    <div class="col-md-6">

      {{! Espacio para imagen o galería futura }}
      <div class="card shadow-sm">
        <div class="card-body text-center">

          <h5 class="mb-3">Imagen del producto</h5>

          {{#if product.thumbnail}}
            <img
              src="{{product.thumbnail}}"
              alt="{{product.title}}"
              class="img-fluid rounded"
            />
          {{else}}
            <div class="text-muted">
              Sin imagen disponible
            </div>
          {{/if}}

        </div>
      </div>

    </div>

  </div>

  <div class="mt-4">
    <a href="/products?page=1" class="btn btn-outline-dark">
      ← Volver a productos
    </a>
  </div>

</div>